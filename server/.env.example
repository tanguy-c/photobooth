# User/group ID for file permissions (match your host user)
# Find yours with: id -u / id -g
PUID=1000
PGID=1000

# Domain for auto TLS (Let's Encrypt). Use "localhost" for local dev.
DOMAIN=photo.example.org

# WebDAV credentials for photo uploads
WEBDAV_USERNAME=photobooth

# Generate hash with: docker run --rm caddy:latest caddy hash-password --plaintext 'your-password'
WEBDAV_PASSWORD_HASH=$2a$14$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
